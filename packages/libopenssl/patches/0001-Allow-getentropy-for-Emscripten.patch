From dc219a04088d08de7df5afdb14263b3e9a4c7915 Mon Sep 17 00:00:00 2001
From: stevenwdv <swdv@cs.ru.nl>
Date: Tue, 11 Aug 2026 16:24:13 -0700
Subject: [PATCH] Allow getentropy for Emscripten

https://github.com/openssl/openssl/pull/31882
---
 providers/implementations/rands/seeding/rand_unix.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/providers/implementations/rands/seeding/rand_unix.c b/providers/implementations/rands/seeding/rand_unix.c
index 57d0f898d9..39dd53dd5f 100644
--- a/providers/implementations/rands/seeding/rand_unix.c
+++ b/providers/implementations/rands/seeding/rand_unix.c
@@ -396,7 +396,7 @@ static ssize_t syscall_random(void *buf, size_t buflen)
     return getrandom(buf, buflen, 0);
 #elif (defined(__FreeBSD__) || defined(__NetBSD__)) && defined(KERN_ARND)
     return sysctl_random(buf, buflen);
-#elif defined(__wasi__)
+#elif defined(__wasi__) || defined(__EMSCRIPTEN__)
     if (getentropy(buf, buflen) == 0)
         return (ssize_t)buflen;
     return -1;
-- 
